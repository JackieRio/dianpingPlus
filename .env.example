# Docker 环境变量配置模板
# 复制此文件为 .env 并修改为实际值

# MySQL 配置
MYSQL_ROOT_PASSWORD=your_mysql_password_here

# Redis 配置
REDIS_PASSWORD=your_redis_password_here

# 后端应用配置
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_hmdp?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your_redis_password_here
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
